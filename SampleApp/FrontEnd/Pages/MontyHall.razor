@page "/montyhall"

<h1>Monty Hall Game</h1>

<div class="doors">
    @for (int i = 0; i < 3; i++)
    {
        <button @onclick="() => SelectDoor(i)" disabled="@hasSelectedDoor" class="door">
            @if (!revealedDoors.Contains(i) && selectedDoor != i && !showResult)
            {
                <span>🚪</span>
            }
            else if(revealedDoors.Contains(i) && doors[i] == "goat")
            {
                <span>🐐</span>
            }
            else if(revealedDoors.Contains(i) && doors[i] == "car")
            {
                <span>🚗</span>
            }
            else if (selectedDoor == i && showResult)
            {
                @if (doors[i] == "car")
                {
                    <span>🚗</span>
                }
                else
                {
                    <span>🐐</span>
                }
            }
             else if (selectedDoor == i)
            {
                 <span>🚪</span>
            }
        </button>
    }
</div>

<div class="message">@message</div>

@if (hasSelectedDoor && !revealedGoat)
{
    <p>The host has opened a door with a goat!</p>
    <div class="choices">
        <button @onclick="Stick" class="btn btn-primary">Stick with my choice</button>
        <button @onclick="Switch" class="btn btn-secondary">Switch to the other door</button>
    </div>
}

@if (!hasSelectedDoor)
{
    <button @onclick="Restart" class="btn btn-success">Restart</button>
}

@if (showResult)
{
    <button @onclick="Restart" class="btn btn-success">Play Again</button>
}
<button @onclick="ResetStats" class="btn btn-danger">Reset Stats</button>

<div class="stats">
    <h2>Statistics</h2>
    <p>Rounds Played: @roundsPlayed</p>
    <p>Wins by Sticking: @winsBySticking (@(roundsPlayed > 0 ? (double)winsBySticking / roundsPlayed * 100 : 0)%)</p>
    <p>Wins by Switching: @winsBySwitching (@(roundsPlayed > 0 ? (double)winsBySwitching / roundsPlayed * 100 : 0)%)</p>
</div>

@code {
    private string[] doors = new string[3];
    private int selectedDoor = -1;
    private int winningDoor = -1;
    private string message = "Select a door.";
    private bool hasSelectedDoor = false;
    private bool revealedGoat = false;
    private List<int> revealedDoors = new List<int>();
    private bool showResult = false;

    private int roundsPlayed = 0;
    private int winsBySticking = 0;
    private int winsBySwitching = 0;

    private Random random = new Random();

    protected override void OnInitialized()
    {
        InitializeGame();
    }

    public void InitializeGame()
    {
        doors = new string[3];
        revealedDoors = new List<int>();
        winningDoor = random.Next(0, 3);

        for (int i = 0; i < 3; i++)
        {
            doors[i] = (i == winningDoor) ? "car" : "goat";
        }

        selectedDoor = -1;
        message = "Select a door.";
        hasSelectedDoor = false;
        revealedGoat = false;
        showResult = false;
    }

    public void SelectDoor(int doorIndex)
    {
        if (doorIndex < 0 || doorIndex >= 3)
        {
            throw new ArgumentOutOfRangeException(nameof(doorIndex), "Door index must be between 0 and 2.");
        }

        selectedDoor = doorIndex;
        hasSelectedDoor = true;
        message = $"You selected door #{doorIndex + 1}.";

        RevealGoat();
        StateHasChanged();
    }

    public void RevealGoat()
    {
        List<int> goatDoors = new List<int>();
        for (int i = 0; i < 3; i++)
        {
            if (doors[i] == "goat" && i != selectedDoor)
            {
                goatDoors.Add(i);
            }
        }

        if (goatDoors.Count > 0)
        {
            int doorToReveal = goatDoors[random.Next(0, goatDoors.Count)];
            revealedDoors.Add(doorToReveal);
            revealedGoat = true;
            message += $" Host revealed door #{doorToReveal + 1} with a goat.";
        }
        StateHasChanged();
    }

    public void Stick()
    {
        ShowResult(selectedDoor);
    }

    public void Switch()
    {
        int newDoor = -1;
        for (int i = 0; i < 3; i++)
        {
            if (i != selectedDoor && !revealedDoors.Contains(i))
            {
                newDoor = i;
                break;
            }
        }

        if (newDoor != -1)
        {
            ShowResult(newDoor);
        }
        else
        {
            // Handle the impossible case where no other door is available.
            message = "Error: No other door to switch to.";
        }
    }

    public void ShowResult(int finalDoor)
    {
        roundsPlayed++;
        showResult = true;

        if (doors[finalDoor] == "car")
        {
            message = "Congratulations! You won a car!";
            if (finalDoor == selectedDoor)
            {
                winsBySticking++;
            }
            else
            {
                winsBySwitching++;
            }
        }
        else
        {
            message = "Sorry, you won a goat.";
        }
        StateHasChanged();
    }

    public void Restart()
    {
        InitializeGame();
        StateHasChanged();
    }

    public void ResetStats()
    {
        roundsPlayed = 0;
        winsBySticking = 0;
        winsBySwitching = 0;
        StateHasChanged();
    }
}