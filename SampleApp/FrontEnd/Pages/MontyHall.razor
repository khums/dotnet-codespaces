@page "/montyhall"

<h3>Monty Hall Game</h3>

<p>Select a door:</p>

<div style="display: flex;">
    @for (int i = 0; i < 3; i++)
    {
        var doorIndex = i; // Capture the current value of i
        <div style="margin: 10px; cursor: pointer; font-size: 2em;" @onclick="() => SelectDoor(doorIndex)">
            🚪
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(Message))
{
    <p>@Message</p>
}

@if (ShowSwitchButtons)
{
    <div>
        <button @onclick="() => MakeFinalChoice(true)">Switch 🔄</button>
        <button @onclick="() => MakeFinalChoice(false)">Stick 🚪</button>
    </div>
}

@if (ShowRestartButton)
{
    <button @onclick="RestartGame">Restart</button>
}

<div>
    <button @onclick="ResetStatistics">Reset Statistics</button>
</div>

<div>
    <p>Rounds Played: @RoundsPlayed</p>
    <p>Wins (Stick): @WinsStick | Losses (Stick): @LossesStick</p>
    <p>Wins (Switch): @WinsSwitch | Losses (Switch): @LossesSwitch</p>
    <p>Win % (Stick): @(RoundsPlayed > 0 ? ((double)WinsStick / (WinsStick + LossesStick) * 100).ToString("F2") : "0.00")%</p>
    <p>Win % (Switch): @(RoundsPlayed > 0 ? ((double)WinsSwitch / (WinsSwitch + LossesSwitch) * 100).ToString("F2") : "0.00")%</p>
</div>

@code {
    private int carDoor { get; set; } = -1;
    private int selectedDoor { get; set; } = -1;
    private int revealedGoatDoor { get; set; } = -1;
    private string Message { get; set; }
    private bool ShowSwitchButtons { get; set; } = false;
    private bool ShowRestartButton { get; set; } = false;

    public int RoundsPlayed { get; set; } = 0;
    public int WinsStick { get; set; } = 0;
    public int LossesStick { get; set; } = 0;
    public int WinsSwitch { get; set; } = 0;
    public int LossesSwitch { get; set; } = 0;

    private Random random = new Random();

    protected override void OnInitialized()
    {
        StartNewGame();
    }

    private void StartNewGame()
    {
        carDoor = random.Next(0, 3);
        selectedDoor = -1;
        revealedGoatDoor = -1;
        Message = "Choose a door.";
        ShowSwitchButtons = false;
        ShowRestartButton = false;
    }

    public void SelectDoor(int doorIndex)
    {
        if (doorIndex < 0 || doorIndex > 2)
        {
            Message = "Invalid door selection.";
            StateHasChanged();
            return;
        }

        if (selectedDoor != -1)
        {
            Message = "You have already selected a door.";
            StateHasChanged();
            return;
        }

        selectedDoor = doorIndex;
        Message = $"You selected door #{selectedDoor + 1}.";
        RevealGoat();
    }

    public void RevealGoat()
    {
        if (selectedDoor == -1)
        {
            Message = "Select a door first!";
            StateHasChanged();
            return;
        }

        List<int> availableGoatDoors = new List<int>();
        for (int i = 0; i < 3; i++)
        {
            if (i != selectedDoor && i != carDoor)
            {
                availableGoatDoors.Add(i);
            }
        }

        if (availableGoatDoors.Count > 0)
        {
            revealedGoatDoor = availableGoatDoors[random.Next(0, availableGoatDoors.Count)];
            Message = $"{Message} I've revealed a goat behind door #{revealedGoatDoor + 1}.  Do you want to switch?";
            ShowSwitchButtons = true;
        }
        else
        {
            //This should not happen, but added for safety
            Message = "Error revealing goat.";
        }
        StateHasChanged();
    }

    public void MakeFinalChoice(bool switchChoice)
    {
        if (revealedGoatDoor == -1)
        {
            Message = "Cannot make a final choice before a goat is revealed.";
            StateHasChanged();
            return;
        }

        int finalChoiceDoor = selectedDoor;
        if (switchChoice)
        {
            for (int i = 0; i < 3; i++)
            {
                if (i != selectedDoor && i != revealedGoatDoor)
                {
                    finalChoiceDoor = i;
                    break;
                }
            }
        }

        RoundsPlayed++;

        bool won = (finalChoiceDoor == carDoor);
        if (switchChoice)
        {
            if (won)
            {
                WinsSwitch++;
                Message = $"You switched to door #{finalChoiceDoor + 1} and WON! 🎉 The car was behind door #{carDoor + 1}.";
            }
            else
            {
                LossesSwitch++;
                Message = $"You switched to door #{finalChoiceDoor + 1} and LOST. 🐐 The car was behind door #{carDoor + 1}.";
            }
        }
        else
        {
            if (won)
            {
                WinsStick++;
                Message = $"You stuck with door #{finalChoiceDoor + 1} and WON! 🎉 The car was behind door #{carDoor + 1}.";
            }
            else
            {
                LossesStick++;
                Message = $"You stuck with door #{finalChoiceDoor + 1} and LOST. 🐐 The car was behind door #{carDoor + 1}.";
            }
        }

        ShowSwitchButtons = false;
        ShowRestartButton = true;
        StateHasChanged();
    }

    public void RestartGame()
    {
        StartNewGame();
        StateHasChanged();
    }

    public void ResetStatistics()
    {
        RoundsPlayed = 0;
        WinsStick = 0;
        LossesStick = 0;
        WinsSwitch = 0;
        LossesSwitch = 0;
        StateHasChanged();
    }
}